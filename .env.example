# ---------------------------------------------------------------------------
# Mewar Sync configuration. Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Server-side secrets (read ONLY by the API server in server/) ----------
# Google Gemini API key. Create a new key in Google AI Studio; restrict it to
# the Generative Language API. If unset, AI features return "not available"
# and the rest of the app keeps working.
GEMINI_API_KEY=

# Optional model overrides
# GEMINI_TEXT_MODEL=gemini-3-flash-preview
# GEMINI_VISION_MODEL=gemini-3.1-pro-preview
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# API server port (Vite proxies /api to it in development)
PORT=8787
# Set when running behind a reverse proxy / load balancer (e.g. 1)
# TRUST_PROXY=1

# --- Firebase web config (public identifiers, safe to ship to browsers) ----
# Access control is enforced by firestore.rules, not by hiding these values.
# Restrict the browser API key to your domains in Google Cloud Console.
VITE_FIREBASE_API_KEY=REMOVED_GOOGLE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=mewar-sync-1e32e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mewar-sync-1e32e
VITE_FIREBASE_STORAGE_BUCKET=mewar-sync-1e32e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1028215744156
VITE_FIREBASE_APP_ID=1:1028215744156:web:674d388cee1d59419c2f59

# --- Feature switches -------------------------------------------------------
# Voice entry (microphone) is hidden by default. Set to true to show it.
VITE_ENABLE_VOICE=false

# --- Cloudinary unsigned image uploads (public preset name) -----------------
# Restrict this preset in Cloudinary to images only, with a max file size.
VITE_CLOUDINARY_CLOUD_NAME=dv3iwgyca
VITE_CLOUDINARY_UPLOAD_PRESET=place_photos

# --- Local development with Firebase emulators (never in production) -------
# VITE_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# AI_PROVIDER=mock   # deterministic demo AI, refused when NODE_ENV=production
