{
  "name": "mewar-sync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "vite build",
    "start": "node server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "node scripts/with-emulators.mjs firestore \"npx vitest run --config vitest.rules.config.ts\"",
    "test:integration": "node scripts/with-emulators.mjs auth,firestore \"npx vitest run --config vitest.integration.config.ts\"",
    "test:e2e": "playwright test",
    "emulators": "node scripts/with-emulators.mjs auth,firestore \"node scripts/wait-forever.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/eczar": "5.2.8",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/mukta": "5.2.8",
    "@google/genai": "^1.38.0",
    "@types/leaflet": "^1.9.21",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "firebase": "^12.10.0",
    "helmet": "8.1.0",
    "jose": "6.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-easy-crop": "^5.5.6",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/express": "5.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "14.27.0",
    "supertest": "7.1.4",
    "tailwindcss": "4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
